# ============================================================
# Content SEO Orchestrator — Environment Variables
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
# ============================================================

# ---- Research (Perplexity API) ----
# Used by /seo-research for Deep Research queries (~$0.45/post)
# Get a key: https://console.perplexity.ai → API Settings
PERPLEXITY_API_KEY=pplx-...

# ---- CMS (Sanity) ----
# Used by /seo-publish to push posts via Sanity HTTP API.
# Required scope: write. Get a token from: sanity.io → Project → API → Tokens
SANITY_AUTH_TOKEN=sk...
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# ---- Instant Indexing (IndexNow — Bing, Yandex, Seznam, Naver) ----
# Generate any 32-char hex key, then host {KEY}.txt at https://yourdomain.com/{KEY}.txt
# Docs: https://www.indexnow.org/documentation
INDEXNOW_KEY=00000000000000000000000000000000
INDEXNOW_HOST=www.example.com

# ---- Keyword Research (optional — choose one) ----
# DataForSEO — pay-as-you-go (~$0.04/query)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ahrefs — for keyword tracking, rank monitoring
AHREFS_API_KEY=

# ---- Google Search Console (optional) ----
# Service-account JSON path for GSC API access
GSC_SERVICE_ACCOUNT=/absolute/path/to/service-account.json
GSC_SITE_URL=https://www.example.com/

# ---- Image generation (optional) ----
# Gemini / OpenAI keys if you wire up cover image generation
GEMINI_API_KEY=
OPENAI_API_KEY=
